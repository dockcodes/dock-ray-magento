{
  "name": "dockcodes/dock-ray-magento",
  "type": "magento2-module",
  "description": "Magento 2 / Adobe Commerce module reporting PHP errors, exceptions, request timings, JavaScript errors, vulnerable software and code integrity to DockRay",
  "homepage": "https://dockray.io",
  "keywords": [
    "magento",
    "magento2",
    "adobe-commerce",
    "error-monitoring",
    "crash-reporting",
    "performance-monitoring",
    "vulnerability-scanner",
    "security",
    "file-integrity"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jacek Sultan",
      "email": "j.sultan@dock.codes",
      "homepage": "https://dock.eu"
    }
  ],
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
    "dockcodes/dock-ray": "^1.4",
    "magento/framework": "^103.0.4",
    "magento/module-authorization": "*",
    "magento/module-backend": "*",
    "magento/module-config": "*",
    "magento/module-cron": "*",
    "magento/module-customer": "*",
    "magento/module-store": "*",
    "magento/module-user": "*"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "DockCodes\\DockRay\\": ""
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
