<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dockray>
            <connection>
                <token/>
                <private_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </connection>
            <general>
                <environment/>
                <release/>
                <traces_sample_rate>0</traces_sample_rate>
                <send_default_pii>0</send_default_pii>
            </general>
            <browser>
                <enabled>0</enabled>
                <sample_rate>1</sample_rate>
            </browser>
            <inventory>
                <enabled>0</enabled>
            </inventory>
            <security>
                <enabled>0</enabled>
            </security>
        </dockray>
    </default>
</config>
