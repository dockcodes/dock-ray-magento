<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The admin-wide notice about vulnerable components in the last report. -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="dockray_vulnerable_components" xsi:type="string">DockCodes\DockRay\Model\System\Message\VulnerableComponents</item>
            </argument>
        </arguments>
    </type>
</config>
