<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!--
            Cheap tick: it only sends when the interval asked for by DockRay has
            passed or the installed software changed. Disabled setting = no-op.
        -->
        <job name="dockray_inventory_tick" instance="DockCodes\DockRay\Cron\InventoryTick" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
    </group>
    <group id="dockray">
        <!--
            Cheap tick as well, but when a report is due it scans the code and
            pub/media for up to a minute - in its own group and process
            (etc/cron_groups.xml), so the jobs of the default group never wait.
        -->
        <job name="dockray_security_tick" instance="DockCodes\DockRay\Cron\SecurityTick" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>
