<?php
/**
 * The stored outcome of the last report. Everything that came from DockRay
 * is untrusted and escaped here; an item's link is rendered only when it
 * points at the configured DockRay server over HTTPS.
 *
 * @var \DockCodes\DockRay\Block\Adminhtml\Dashboard $block
 * @var \Magento\Framework\Escaper $escaper
 */
$result = $block->inventoryResult();
$enabled = $block->inventoryEnabled();
?>
<?php if ($result === null): ?>
    <div class="dockray-empty">
        <span class="dockray-empty__icon" aria-hidden="true"></span>
        <p><?= $escaper->escapeHtml($enabled
            ? __('No report has been sent yet. The first one goes out with the next Magento cron run.')
            : __('No report has been sent yet.')) ?></p>
    </div>
<?php return; endif; ?>

<?php
$at = (int) ($result['at'] ?? 0);
$report = is_array($result['report'] ?? null) ? $result['report'] : null;
?>
<div class="dockray-inventory__status">
    <?php if (! empty($result['success'])): ?>
        <span class="dockray-pill dockray-pill--ok"><span class="dockray-pill__dot" aria-hidden="true"></span><?= $escaper->escapeHtml(__('Sent %1 ago', $block->timeAgo($at))) ?></span>
    <?php else: ?>
        <span class="dockray-pill dockray-pill--error"><span class="dockray-pill__dot" aria-hidden="true"></span><?= $escaper->escapeHtml(__('Failed %1 ago', $block->timeAgo($at))) ?></span>
    <?php endif; ?>
    <span class="dockray-note"><?= $escaper->escapeHtml($block->formatTimestamp($at)) ?></span>
    <?php if ($enabled && ! empty($result['next_at'])): ?>
        <span class="dockray-note">· <?= $escaper->escapeHtml(__('Next scheduled report: %1', $block->formatTimestamp(max((int) $result['next_at'], time())))) ?></span>
    <?php endif; ?>
</div>

<?php if (empty($result['success'])): ?>
    <p class="dockray-result dockray-result--error">
        <?= $escaper->escapeHtml($block->errorLabel($result)) ?>
        <?php if ((int) ($result['status'] ?? 0) > 0): ?>
            <?= $escaper->escapeHtml(__('(HTTP %1)', (int) $result['status'])) ?>
        <?php endif; ?>
    </p>
    <?php if (($result['message'] ?? '') !== ''): ?>
        <p class="dockray-note"><?= $escaper->escapeHtml(__('Server message: %1', (string) $result['message'])) ?></p>
    <?php endif; ?>
<?php endif; ?>

<?php if ($report === null) {
    return;
} ?>

<?php if (empty($result['success'])): ?>
    <p class="dockray-note"><?= $escaper->escapeHtml(__('Findings below come from the last successful report, %1.', $block->formatTimestamp((int) $report['at']))) ?></p>
<?php endif; ?>

<div class="dockray-stats">
    <div class="dockray-stat">
        <span class="dockray-stat__value"><?= /* @noEscape */ (int) $report['components'] ?></span>
        <span class="dockray-stat__label"><?= $escaper->escapeHtml(__('Components checked')) ?></span>
    </div>
    <div class="dockray-stat <?= /* @noEscape */ (int) $report['vulnerable'] > 0 ? 'dockray-stat--danger' : 'dockray-stat--ok' ?>">
        <span class="dockray-stat__value"><?= /* @noEscape */ (int) $report['vulnerable'] ?></span>
        <span class="dockray-stat__label"><?= $escaper->escapeHtml(__('Vulnerable')) ?></span>
    </div>
    <div class="dockray-stat <?= /* @noEscape */ (int) $report['unverified'] > 0 ? 'dockray-stat--warning' : '' ?>">
        <span class="dockray-stat__value"><?= /* @noEscape */ (int) $report['unverified'] ?></span>
        <span class="dockray-stat__label"><?= $escaper->escapeHtml(__('Unverified')) ?></span>
    </div>
</div>

<?php if ((int) $report['unverified'] > 0): ?>
    <p class="dockray-note"><?= $escaper->escapeHtml(__('Unverified components match a known vulnerability by name, but the source gives no version range - check them in the DockRay panel.')) ?></p>
<?php endif; ?>

<?php $items = is_array($report['items'] ?? null) ? $report['items'] : []; ?>
<?php if ($items === []): ?>
    <?php if ((int) $report['vulnerable'] === 0): ?>
        <p class="dockray-result dockray-result--ok"><?= $escaper->escapeHtml(__('No known vulnerabilities in the installed versions.')) ?></p>
    <?php endif; ?>
    <?php return; ?>
<?php endif; ?>

<div class="dockray-table-wrap">
    <table class="dockray-table">
        <thead>
        <tr>
            <th scope="col"><?= $escaper->escapeHtml(__('Component')) ?></th>
            <th scope="col"><?= $escaper->escapeHtml(__('Installed')) ?></th>
            <th scope="col"><?= $escaper->escapeHtml(__('Severity')) ?></th>
            <th scope="col"><?= $escaper->escapeHtml(__('Vulnerability')) ?></th>
            <th scope="col"><?= $escaper->escapeHtml(__('Fixed in')) ?></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($items as $item): ?>
            <?php
            $severity = $block->isSeverity((string) ($item['severity'] ?? '')) ? (string) $item['severity'] : 'unknown';
            $title = (string) ($item['title'] ?? '');
            $title = $title !== '' ? $title : (string) __('no title');
            $url = $block->safeItemUrl((string) ($item['url'] ?? ''));
            ?>
            <tr>
                <td>
                    <span class="dockray-type"><?= $escaper->escapeHtml($block->componentTypeLabel((string) ($item['type'] ?? ''))) ?></span>
                    <code><?= $escaper->escapeHtml((string) ($item['slug'] ?? '')) ?></code>
                </td>
                <td><?= $escaper->escapeHtml((string) ($item['version'] ?? '')) ?></td>
                <td><span class="dockray-severity dockray-severity--<?= $escaper->escapeHtmlAttr($severity) ?>"><?= $escaper->escapeHtml($block->severityLabel($severity)) ?></span></td>
                <td>
                    <?php if ($url !== null): ?>
                        <a href="<?= $escaper->escapeUrl($url) ?>" target="_blank" rel="noopener noreferrer"><?= $escaper->escapeHtml($title) ?></a>
                    <?php else: ?>
                        <?= $escaper->escapeHtml($title) ?>
                    <?php endif; ?>
                </td>
                <td><?= $escaper->escapeHtml(($item['fixed_in'] ?? null) !== null ? (string) $item['fixed_in'] : __('No fix yet')) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>
